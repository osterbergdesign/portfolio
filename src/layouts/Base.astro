---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { getAbout } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of a social preview image. */
  image?: string;
}

const about = await getAbout();
const { name, email, phone, location, linkedin, github } = about.data;
const siteTitle = `${name} — Industrial & technical design`;
const { title, description = `Portfolio of ${name}: product design, prototyping, interaction and visualization.`, image } = Astro.props;
const fullTitle = title ? `${title} — ${name}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/projects/', label: 'Projects', active: path.startsWith('/projects') },
  { href: '/consulting/', label: 'Consulting', active: path.startsWith('/consulting') },
  { href: '/about/', label: 'About', active: path.startsWith('/about') },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/InterDisplay-Black.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/Inter-Regular.woff" as="font" type="font/woff" crossorigin />
    <meta name="theme-color" content="#FAF8F3" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Scroll motion is opt-in: content is only hidden for reveal animations once this class is set,
      // and the class is dropped again if the motion script hasn't started within 2.5 s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () {
          if (!window.__motion) {
            window.__motionOff = true;
            document.documentElement.classList.remove('motion');
          }
        }, 2500);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-logo" href="/" aria-label={`${name}, home`}>
          <span class="site-logo__mark"><Logo /></span>
        </a>
        <nav aria-label="Main">
          <ul class="site-nav">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a class="site-nav__mail" href={`mailto:${email}`}>Email me</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__lead">
          <p class="site-footer__title">Have a thesis project for spring 2027? I'd like to hear about it.</p>
          <a class="site-footer__email" href={`mailto:${email}`}>{email}</a>
        </div>
        <dl class="site-footer__meta">
          {phone && (<div><dt>Phone</dt><dd><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></dd></div>)}
          <div><dt>Based in</dt><dd>{location}</dd></div>
          <div><dt>Consulting</dt><dd><a href="/consulting/">3D printing and design jobs</a></dd></div>
          {linkedin && (<div><dt>LinkedIn</dt><dd><a href={linkedin}>Profile</a></dd></div>)}
          {github && (<div><dt>GitHub</dt><dd><a href={github}>{github.replace(/^https?:\/\/(www\.)?github\.com\//, '')}</a></dd></div>)}
        </dl>
        <div class="site-footer__base">
          <span class="site-footer__mark"><Logo /></span>
          <small>© {year} {name}</small>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
