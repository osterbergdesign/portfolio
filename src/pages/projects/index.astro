---
import Base from '../../layouts/Base.astro';
import ProjectListing from '../../components/ProjectListing.astro';
import { getProjects } from '../../lib/content';

const work = await getProjects('work');
const hobby = await getProjects('hobby');
---

<Base title="Projects" description="Product design, prototyping, interaction, materials and visualization projects.">
  <ProjectListing projects={work} active="work" workCount={work.length} hobbyCount={hobby.length} />
</Base>
