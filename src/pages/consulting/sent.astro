---
// Shown after the contact form is sent from a browser without JavaScript.
import Base from '../../layouts/Base.astro';
---

<Base title="Message sent" description="Your message has been sent.">
  <section class="page-head container not-found">
    <h1 class="page-title" data-reveal="rise">Thanks.</h1>
    <p class="page-lede">Your message is on its way, and I'll reply to the email address you gave.</p>
    <div class="button-row">
      <a class="button" href="/projects/">See my projects</a>
      <a class="button button--ghost" href="/consulting/">Back to consulting</a>
    </div>
  </section>
</Base>
