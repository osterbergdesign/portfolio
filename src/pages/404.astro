---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="page-head container not-found">
    <h1 class="page-title">404.</h1>
    <p class="page-lede">This page doesn't exist — it may have moved when a project was renamed.</p>
    <div class="button-row">
      <a class="button" href="/projects/">See all projects</a>
      <a class="button button--ghost" href="/">Go to the home page</a>
    </div>
  </section>
</Base>
