---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Pattern from '../components/Pattern.astro';
import Signature from '../components/Signature.astro';
import { getProjects, getAbout, getHome, widthsFor } from '../lib/content';

const projects = await getProjects('work');
const about = await getAbout();
const home = (await getHome()).data;
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const lead = featured[0];
const years = projects.map((p) => p.data.year).filter((y): y is number => typeof y === 'number');
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';

// Each "How I work" step gets the next shape in this list.
const shapes = ['circle', 'square', 'triangle', 'quarter'];
const steps = home.steps.map((step, i) => ({ ...step, shape: shapes[i % shapes.length] }));

// The moving band of words between "How I work" and the projects. Purely decorative.
const marquee = [home.marquee, home.marqueeOutline].filter((row) => row.length > 0);
const cta = home.cta?.show ? home.cta : undefined;
---

<Base description={`${about.data.name} — industrial design engineering student in Luleå. ${about.data.availability ?? ''}`} image={lead?.data.cover.src}>
  <section class="hero" aria-labelledby="hero-title" data-progress="exit">
    <div class="container hero__grid">
      <div class="hero__type">
        <div class="hero__headline">
          <p class="hero__label">{home.heroLabel}</p>
          <h1 id="hero-title" class="hero__title"><span>Port</span><span>folio.</span></h1>
        </div>
        <div class="hero__byline">
          <p class="hero__name">{about.data.name}</p>
          {span && <p>Work {span}</p>}
        </div>
      </div>

      <div class="hero__panel">
        <Pattern class="hero__pattern" />
        {
          lead && (
            <a class="hero__piece" href={`/projects/${lead.id}/`} style={`--cover-position: ${lead.data.coverPosition}`}>
              <Image
                src={lead.data.cover}
                alt={lead.data.coverAlt}
                widths={widthsFor(lead.data.cover, [600, 900, 1200])}
                sizes="(min-width: 900px) 40vw, 90vw"
                loading="eager"
              />
              <span class="hero__piece-label">{lead.data.title}</span>
            </a>
          )
        }
        {home.heroCaption && <p class="hero__caption">{home.heroCaption}</p>}
      </div>
    </div>
  </section>

  <section class="intro container" aria-label="Introduction">
    <div>
      <p class="intro__statement" data-reveal="rise">{home.intro}</p>
      <Signature class="intro__signature" />
    </div>
    {
      about.data.availability && (
        <aside class="intro__availability accent-navy" data-reveal="wipe">
          <p class="intro__availability-title">{about.data.availability}</p>
          {home.availabilityNote && <p>{home.availabilityNote}</p>}
          <div class="button-row">
            <a class="button button--light" href="/projects/">See the projects</a>
            <a class="button button--ghost-light" href="/about/">Read my CV</a>
          </div>
        </aside>
      )
    }
  </section>

  {
    steps.length > 0 && (
      <section class="process container" aria-labelledby="process-title">
        <h2 id="process-title" class="section-title" data-reveal="rise">{home.stepsTitle}</h2>
        <ol class="process__steps">
          {steps.map((step) => (
            <li class="process__step" data-reveal="roll">
              <span class={`shape shape--${step.shape}`} aria-hidden="true" />
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    marquee.length > 0 && (
      <div class="marquee" aria-hidden="true" data-progress="through">
        {marquee.map((words, row) => (
          <div class:list={['marquee__row', { 'marquee__row--outline': row === 1 }]}>
            {[0, 1, 2].flatMap((rep) =>
              words.map((word, i) => (
                <span class="marquee__item">
                  {word}
                  <span class={`shape shape--${shapes[(i + row + rep) % shapes.length]}`} />
                </span>
              )),
            )}
          </div>
        ))}
      </div>
    )
  }

  <section class="selected container" aria-labelledby="selected-title">
    <div class="section-head">
      <h2 id="selected-title" class="section-title" data-reveal="rise">{home.selectedTitle}</h2>
      <a class="text-link" href="/projects/">All {projects.length} projects</a>
    </div>
    <div class="selected__grid">
      {featured.map((p, i) => <ProjectCard project={p} size={i === 0 ? 'large' : 'regular'} />)}
    </div>
  </section>

  {
    cta && (
      <section class="cta-band accent-mustard" aria-labelledby="cta-title" data-progress="through">
        <span class="cta-band__shape" aria-hidden="true" />
        <div class="container cta-band__inner">
          <div data-reveal="rise">
            {cta.kicker && <p class="cta-band__kicker">{cta.kicker}</p>}
            <h2 id="cta-title" class="cta-band__title">{cta.title}</h2>
          </div>
          <div class="cta-band__body" data-reveal="rise">
            {cta.text && <p>{cta.text}</p>}
            <div class="button-row">
              <a class="button" href="/consulting/">{cta.button}</a>
            </div>
          </div>
        </div>
      </section>
    )
  }
</Base>
