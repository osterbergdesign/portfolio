---
import ProjectCard from './ProjectCard.astro';
import { disciplinesOf, getAbout, getHome, slugify, type Project, type Category } from '../lib/content';

interface Props {
  projects: Project[];
  active: Category;
  workCount: number;
  hobbyCount: number;
}

const { projects, active, workCount, hobbyCount } = Astro.props;
const { github } = (await getAbout()).data;
const disciplines = disciplinesOf(projects);
// The tabs only appear once there is at least one hobby project to show.
const showTabs = hobbyCount > 0 || active === 'hobby';
const home = (await getHome()).data;
const lede = active === 'work' ? home.projectsLede.replaceAll('{count}', String(projects.length)) : home.hobbyLede;
---

<section class="page-head container">
  <h1 class="page-title" data-reveal="rise">Projects</h1>
  <p class="page-lede">
    {lede}
    {active === 'hobby' && github && <> The code is <a href={github}>on GitHub</a>.</>}
  </p>
</section>

<section class="container" aria-label="Project list">
  {
    showTabs && (
      <nav class="tabs" aria-label="Project type">
        <a class="tabs__tab" href="/projects/" aria-current={active === 'work' ? 'page' : undefined}>
          Design work <span class="tabs__count">{workCount}</span>
        </a>
        <a class="tabs__tab" href="/projects/hobby/" aria-current={active === 'hobby' ? 'page' : undefined}>
          Hobby projects <span class="tabs__count">{hobbyCount}</span>
        </a>
      </nav>
    )
  }

  {
    disciplines.length > 1 && (
      <>
        <div class="filter" role="group" aria-label="Filter by discipline" hidden>
          <button type="button" class="filter__chip" data-filter="all" aria-pressed="true">All</button>
          {disciplines.map((d) => (
            <button type="button" class="filter__chip" data-filter={slugify(d)} aria-pressed="false">
              {d}
            </button>
          ))}
        </div>
        <p class="filter__status visually-hidden" aria-live="polite" />
      </>
    )
  }

  {
    projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((p) => (
          <ProjectCard project={p} headingLevel="h2" />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No hobby projects are published yet.</p>
        <a class="button" href="/projects/">See the design work</a>
      </div>
    )
  }
</section>

<script>
  // Progressive enhancement: the full list works without JavaScript.
  const group = document.querySelector<HTMLElement>('.filter');
  const status = document.querySelector<HTMLElement>('.filter__status');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-grid .card'));
  if (group) {
    group.hidden = false;
    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter ?? 'all';
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let shown = 0;
      for (const card of cards) {
        const match = filter === 'all' || (card.dataset.disciplines ?? '').split(' ').includes(filter);
        card.hidden = !match;
        if (match) shown++;
      }
      if (status) status.textContent = `Showing ${shown} of ${cards.length} projects`;
    });
  }
</script>
