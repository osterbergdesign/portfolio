---
/**
 * The tile artwork in the hero: 8 x 4 Bauhaus tiles. Each tile is its own small <svg>, so its shape
 * can pop in on load and turn as the page scrolls (see "Motion" in global.css) while staying inside
 * its square. To change the artwork, edit the colours and shapes below — each tile is 100 x 100 units.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <svg class="tile" x="0" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 0; --turn: 90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(0 0)"><circle cx="50.0" cy="50.0" r="36.0" fill="#DCCDB2" /></g></g></g></svg>
  <svg class="tile" x="100" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 1; --turn: -180deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-100 0)"><path d="M100 0 L200 0 A50.0 50.0 0 0 1 100 0 Z" fill="#DCCDB2" transform="rotate(270 150.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="200" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 2; --turn: 180deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-200 0)"><path d="M200 0 L300 0 L200 100 Z" fill="#D2452A" transform="rotate(180 250.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="300" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 3; --turn: -90deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-300 0)"><path d="M300 0 L400 0 L300 100 Z" fill="#D2452A" transform="rotate(90 350.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="400" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 4; --turn: 90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-400 0)"><path d="M400 0 L500 0 L400 100 L500 100 Z" fill="#243049" transform="rotate(270 450.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="500" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 5; --turn: -180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-500 0)"><path d="M500 0 L600 0 L500 100 Z" fill="#243049" transform="rotate(0 550.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="600" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 6; --turn: 180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-600 0)"><path d="M600 0 L700 0 L600 100 Z" fill="#D2452A" transform="rotate(90 650.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="700" y="0" width="101" height="101" viewBox="0 0 101 101" style="--i: 7; --turn: -90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-700 0)"><path d="M700 0 L800 0 A100 100 0 0 1 700 100 Z" fill="#DCCDB2" transform="rotate(180 750.0 50.0)" /></g></g></g></svg>
  <svg class="tile" x="0" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 1; --turn: -90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(0 -100)"><path d="M0 100 L100 100 A100 100 0 0 1 0 200 Z" fill="#DCCDB2" transform="rotate(0 50.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="100" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 2; --turn: 90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-100 -100)"><circle cx="150.0" cy="150.0" r="36.0" fill="#DCCDB2" /></g></g></g></svg>
  <svg class="tile" x="200" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 3; --turn: -180deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-200 -100)"><path d="M200 100 L300 100 L200 200 Z" fill="#FAF8F3" transform="rotate(180 250.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="300" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 4; --turn: 180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-300 -100)"><path d="M300 100 L400 100 A100 100 0 0 1 300 200 Z" fill="#FAF8F3" transform="rotate(0 350.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="400" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 5; --turn: -90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-400 -100)"><path d="M400 100 L500 100 L400 200 Z" fill="#243049" transform="rotate(0 450.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="500" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 6; --turn: 90deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-500 -100)"><path d="M500 100 L600 100 A100 100 0 0 1 500 200 Z" fill="#FAF8F3" transform="rotate(90 550.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="600" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 7; --turn: -180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-600 -100)"><path d="M600 100 L700 100 A50.0 50.0 0 0 1 600 100 Z" fill="#243049" transform="rotate(270 650.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="700" y="100" width="101" height="101" viewBox="0 0 101 101" style="--i: 8; --turn: 180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-700 -100)"><path d="M700 100 L800 100 A100 100 0 0 1 700 200 Z" fill="#FAF8F3" transform="rotate(180 750.0 150.0)" /></g></g></g></svg>
  <svg class="tile" x="0" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 2; --turn: 180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(0 -200)"><path d="M0 200 L100 200 A50.0 50.0 0 0 1 0 200 Z" fill="#FAF8F3" transform="rotate(180 50.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="100" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 3; --turn: -90deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-100 -200)"><path d="M100 200 L200 200 L100 300 Z" fill="#FAF8F3" transform="rotate(180 150.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="200" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 4; --turn: 90deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-200 -200)"><path d="M200 200 L300 200 A100 100 0 0 1 200 300 Z" fill="#243049" transform="rotate(180 250.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="300" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 5; --turn: -180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-300 -200)"><circle cx="350.0" cy="250.0" r="36.0" fill="#FAF8F3" /></g></g></g></svg>
  <svg class="tile" x="400" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 6; --turn: 180deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-400 -200)"><path d="M400 200 L500 200 A50.0 50.0 0 0 1 400 200 Z" fill="#DCCDB2" transform="rotate(90 450.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="500" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 7; --turn: -90deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-500 -200)"><path d="M500 200 L600 200 A50.0 50.0 0 0 1 500 200 Z" fill="#FAF8F3" transform="rotate(0 550.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="600" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 8; --turn: 90deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-600 -200)"><path d="M600 200 L700 200 L600 300 L700 300 Z" fill="#DCCDB2" transform="rotate(0 650.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="700" y="200" width="101" height="101" viewBox="0 0 101 101" style="--i: 9; --turn: -180deg"><rect width="101" height="101" fill="#243049" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-700 -200)"><path d="M700 200 L800 200 L700 300 L800 300 Z" fill="#FAF8F3" transform="rotate(0 750.0 250.0)" /></g></g></g></svg>
  <svg class="tile" x="0" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 3; --turn: -180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(0 -300)"><path d="M0 300 L100 300 L0 400 L100 400 Z" fill="#FAF8F3" transform="rotate(270 50.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="100" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 4; --turn: 180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-100 -300)"><path d="M100 300 L200 300 L100 400 Z" fill="#FAF8F3" transform="rotate(90 150.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="200" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 5; --turn: -90deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-200 -300)"><path d="M200 300 L300 300 A50.0 50.0 0 0 1 200 300 Z" fill="#243049" transform="rotate(90 250.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="300" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 6; --turn: 90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-300 -300)"><path d="M300 300 L400 300 L300 400 Z" fill="#DCCDB2" transform="rotate(90 350.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="400" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 7; --turn: -180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-400 -300)"><path d="M400 300 L500 300 L400 400 L500 400 Z" fill="#FAF8F3" transform="rotate(180 450.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="500" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 8; --turn: 180deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-500 -300)"><path d="M500 300 L600 300 A100 100 0 0 1 500 400 Z" fill="#FAF8F3" transform="rotate(90 550.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="600" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 9; --turn: -90deg"><rect width="101" height="101" fill="#FAF8F3" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-600 -300)"><path d="M600 300 L700 300 L600 400 L700 400 Z" fill="#243049" transform="rotate(270 650.0 350.0)" /></g></g></g></svg>
  <svg class="tile" x="700" y="300" width="101" height="101" viewBox="0 0 101 101" style="--i: 10; --turn: 90deg"><rect width="101" height="101" fill="#DCCDB2" /><g class="tile__in"><g class="tile__spin"><g transform="translate(-700 -300)"><path d="M700 300 L800 300 L700 400 L800 400 Z" fill="#243049" transform="rotate(0 750.0 350.0)" /></g></g></g></svg>
</svg>
