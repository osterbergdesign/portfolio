# Contact form settings. Copy this file to .env on the server and fill it in:
#   cp .env.example .env && nano .env
# .env holds a password, so it is ignored by git — never commit it.
#
# Gmail: turn on 2-step verification for the account, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=abcdabcdabcdabcd

# Where messages go. Leave empty to send them to SMTP_USER.
CONTACT_TO=
