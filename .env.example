# Settings for the editor and the contact form. Copy this file to .env on the server and fill it in:
#   cp .env.example .env && nano .env
# .env holds passwords, so it is ignored by git — never commit it.

# ---- Editor (edit.osterbergdesign.site) ----
# The password for logging in to the editor. Use something long. Without it the editor stays switched off
# (the public site is still built and served).
EDITOR_PASSWORD=

# Lets "Publish" save your changes to GitHub, so they and Claude's changes stay in step.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
# with access to only the portfolio repository and "Contents: Read and write".
GITHUB_TOKEN=

# Name and email on the commits the editor makes.
GIT_AUTHOR_NAME=Max Österberg
GIT_AUTHOR_EMAIL=you@example.com

# ---- Contact form (/consulting/) ----
# Gmail: turn on 2-step verification for the account, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=abcdabcdabcdabcd

# Where messages go. Leave empty to send them to SMTP_USER.
CONTACT_TO=
